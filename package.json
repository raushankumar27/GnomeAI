    "start": "electron . --no-sandbox --disable-gpu --disable-vulkan --ozone-platform=x11 --class=org-gnome-gnomeai",
    "dev": "electron . --no-sandbox --disable-gpu --disable-vulkan --ozone-platform=x11 --class=org-gnome-gnomeai",

